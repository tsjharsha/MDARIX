POSTGRES_DB=mdarix_r1
POSTGRES_USER=mdarix_app
POSTGRES_PASSWORD=CHANGE_ME
# Database hardening is opt-in and must be applied before switching runtime credentials.
MDARIX_DB_HARDENING_APPLY=0
MDARIX_DB_POOL_SIZE=5
MDARIX_DB_MAX_OVERFLOW=10
MDARIX_DB_POOL_TIMEOUT_SECONDS=30

# GenAI provider: groq (API key required) or ollama (local, no key required)
MDARIX_GENAI_PROVIDER=controlled
MDARIX_GENAI_MODEL=mdarix-controlled
MDARIX_GENAI_API_KEY=
MDARIX_GENAI_BASE_URL=
MDARIX_GENAI_TIMEOUT_SECONDS=20
MDARIX_GENAI_MAX_RETRIES=2

# Free trial: email address that receives an alert for each new website trial request (empty = no alert)
MDARIX_TRIAL_ALERT_EMAIL=

# development | test | staging | production. Unset or unknown means production, with every protection on.
MDARIX_ENV=production

# Connectors: secrets must be named MDARIX_CONNECTOR_SECRET_<NAME>. Internal/private hosts are refused unless listed here
# (comma-separated host or host:port, e.g. local simulators "127.0.0.1:8101"). Leave empty on servers.
MDARIX_CONNECTOR_ALLOWED_HOSTS=
