POSTGRES_DB=mdarix_r1
POSTGRES_USER=mdarix_app
POSTGRES_PASSWORD=CHANGE_ME
# Database hardening is opt-in and must be applied before switching runtime credentials.
MDARIX_DB_HARDENING_APPLY=0
MDARIX_DB_POOL_SIZE=5
MDARIX_DB_MAX_OVERFLOW=10
MDARIX_DB_POOL_TIMEOUT_SECONDS=30

# GenAI provider: groq (API key required) or ollama (local, no key required)
MDARIX_GENAI_PROVIDER=controlled
MDARIX_GENAI_MODEL=mdarix-controlled
MDARIX_GENAI_API_KEY=
MDARIX_GENAI_BASE_URL=
MDARIX_GENAI_TIMEOUT_SECONDS=20
MDARIX_GENAI_MAX_RETRIES=2
# Fallbacks, tried in order when the provider above is rate-limited or down (then the rule-based answer).
# Any of: groq, cerebras, gemini, openrouter, mistral, github, ollama. Each reads MDARIX_GENAI_<NAME>_API_KEY and,
# optionally, _MODEL / _BASE_URL. Free tiers: synthetic demo data only. See docs/runbooks/AI_PROVIDERS.md.
MDARIX_GENAI_FALLBACKS=
MDARIX_GENAI_CEREBRAS_API_KEY=
MDARIX_GENAI_GEMINI_API_KEY=
MDARIX_GENAI_OPENROUTER_API_KEY=
# How long a provider that hit its limit is skipped (seconds), and one that was down.
MDARIX_GENAI_RATE_LIMIT_REST_SECONDS=900
MDARIX_GENAI_OUTAGE_REST_SECONDS=60
# Evidence search embeddings: local (language model on this server, default) or deterministic (word hashes).
MDARIX_EMBEDDING_PROVIDER=local
# Where the embedding model is stored after its one-time download (default: .model-cache in the repository).
MDARIX_EMBEDDING_CACHE_DIR=

# Free trial: email address that receives an alert for each new website trial request (empty = no alert)
MDARIX_TRIAL_ALERT_EMAIL=

# development | test | staging | production. Unset or unknown means production, with every protection on.
MDARIX_ENV=production

# Connectors: secrets must be named MDARIX_CONNECTOR_SECRET_<NAME>. Internal/private hosts are refused unless listed here
# (comma-separated host or host:port, e.g. local simulators "127.0.0.1:8101"). Leave empty on servers.
MDARIX_CONNECTOR_ALLOWED_HOSTS=

# Database login the API uses: a least-privilege role, so Postgres row-level security isolates tenants.
# Create its login once with: python scripts/configure_runtime_role.py (run with the owner credentials above).
MDARIX_DB_RUNTIME_USER=mdarix_runtime
MDARIX_DB_RUNTIME_PASSWORD=

# Multi-factor authentication (authenticator app). Secrets are encrypted with this key: URL-safe base64 of 32 random
# bytes, e.g. python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())". Required on
# every server; local development uses a built-in key. Keep it safe: losing it means everyone re-enrolls.
MDARIX_MFA_ENCRYPTION_KEY=
# Roles that must set up MFA before they can do anything (default outside development: PLATFORM_ADMIN,CUSTOMER_ADMIN).
MDARIX_REQUIRE_MFA_ROLES=PLATFORM_ADMIN,CUSTOMER_ADMIN
# Governed decision signatures need a fresh authenticator code (true by default).
MDARIX_REQUIRE_MFA_FOR_SIGNATURES=true
# Signed-in sessions end on the server after this many minutes without activity (the 60-minute maximum still applies).
MDARIX_SESSION_IDLE_MINUTES=30
# Extra browser origins trusted for signed-in changes besides MDARIX_APP_URL (comma-separated, rarely needed).
MDARIX_ALLOWED_ORIGINS=
