# Every text file is stored with LF line endings, whatever each developer's core.autocrlf says; a checkout may still
# use the platform's endings. The rules below that pin eol=lf keep LF in the working copy too.
* text=auto

# Binary files are never converted or diffed as text.
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.gz binary
*.zip binary
*.xlsx binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# The golden dataset generator writes LF line endings on every platform.
# Checking these files out with LF keeps them byte-identical to regenerated
# output, so ingestion's file checksums (idempotency) are platform-independent.
data/golden/** text eol=lf
evaluation/ground_truth/** text eol=lf
evaluation/scenarios/** text eol=lf
# Files that run inside Linux containers must keep LF line endings on every platform.
*.sh text eol=lf
Dockerfile* text eol=lf
infrastructure/docker/** text eol=lf
infrastructure/staging/** text eol=lf
docker-compose*.yml text eol=lf
# The published code lists (0.10.77) stay byte-identical to the publishers' files: their SHA-256 is in the manifest.
data/code_lists/** -text
data/code_lists/manifest.json text eol=lf
# FDA's fillable 3500A and eMDR schemas stay byte-identical to FDA's files (their SHA-256 is in the manifest).
data/fda_forms/** -text
data/fda_forms/manifest.json text eol=lf
# The Commission's and MHRA's MIR files (B8) stay byte-identical (their SHA-256 is in the manifest).
data/mir_forms/** -text
data/mir_forms/manifest.json text eol=lf
# FDA's example eMDR files stay byte-identical (their SHA-256 is in the fixtures' manifest).
tests/fixtures/emdr_examples/*.xml -text

# The rule register's data and the files it pins by SHA-256 (rule books, form editions' manifests and field maps):
# LF on every platform, so a pin taken on Windows holds on a Linux checkout (the register also hashes text files with
# LF endings). Blank forms are PDFs, kept byte-identical by the binary rule above.
backend/app/rule_register/data/** text eol=lf
backend/app/authority_reports/rules/** text eol=lf
data/mvpi_forms/*.json text eol=lf
data/hc_forms/*.json text eol=lf
