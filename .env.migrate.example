# MDARIX owner and backup credentials (docker-compose.prod.yml). Copy to .env.migrate on the server next to
# .env.production, fill it, chmod 600, and never commit the filled file.
#
# Only two one-shot jobs load this file, on top of .env.production: "migrate" (schema migrations, roles, grants,
# the system-scope token, bootstrap scripts such as create_platform_admin.py) and "backup". The long-running api,
# worker and scheduler never see it, and refuse to start if MDARIX_DB_OWNER_PASSWORD, MDARIX_BACKUP_DB_PASSWORD or a
# MDARIX_DATA_PLANE_..._OWNER value reaches their environment (backend/app/config_check.py).
# Full reference: docs/runbooks/ENVIRONMENT_VARIABLES.md

# ---------------------------------------------------------------- Database owner (the migrate job)
# The schema owner's password. Its user name is MDARIX_DB_OWNER_USER in .env.production; the migrate job connects as
# that account (it becomes POSTGRES_USER / POSTGRES_PASSWORD inside the job).
MDARIX_DB_OWNER_PASSWORD=

# ---------------------------------------------------------------- Dedicated tenant databases (optional)
# The owner connection string of each dedicated plane, used to migrate it and to back it up, e.g.:
# MDARIX_DATA_PLANE_ACME_DATABASE_URL_OWNER=postgresql+pg8000://mdarix_owner:...@host:5432/mdarix_acme

# ---------------------------------------------------------------- Backups (docs/runbooks/BACKUP_AND_RESTORE.md)
# Read-only login that may read every organization's rows (BYPASSRLS), created once with
#   docker compose -f docker-compose.prod.yml --env-file .env.production run --rm migrate python scripts/configure_backup_role.py
# Empty: backups log in as the owner and read through the system scope (MDARIX_RLS_SYSTEM_TOKEN) instead.
MDARIX_BACKUP_DB_USER=mdarix_backup
MDARIX_BACKUP_DB_PASSWORD=
# Write-only credentials for MDARIX_BACKUP_S3_URI (an IAM user or access key allowed s3:PutObject and s3:ListBucket
# on that bucket only). Leave empty when the VM has an instance role with that permission.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
