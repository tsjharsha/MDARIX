# MDARIX front door (docker-compose.prod.yml). Caddy obtains and renews the TLS certificate for MDARIX_DOMAIN
# automatically (Let's Encrypt), redirects HTTP to HTTPS, serves the built frontend and proxies the API.
{
	email {$ACME_EMAIL}
	# Uploads above this are refused here, before they reach the API (imports allow 10 MB, attachments 10 MB).
	servers {
		max_header_size 32KB
	}
}

{$MDARIX_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
		-Server
	}

	# Readiness details are for the operator, not the internet.
	@internal_health path /health /health/ready
	handle @internal_health {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /health/live {
		reverse_proxy api:8000
	}

	# Built assets carry a content hash in their names: cache them for a year. Pages are revalidated every time,
	# so a deploy reaches everyone at once.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
