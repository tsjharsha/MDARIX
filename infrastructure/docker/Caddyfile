# MDARIX front door (docker-compose.prod.yml). Caddy obtains and renews the TLS certificate for MDARIX_DOMAIN
# automatically (Let's Encrypt), redirects HTTP to HTTPS, serves the built frontend and proxies the API.
# (For MDARIX_DOMAIN=localhost, as in CI, Caddy issues the certificate from its own local CA instead.)
{
	email {$ACME_EMAIL}
	servers {
		max_header_size 32KB
	}
}

# Who may open the site: MDARIX_SITE_ACCESS is "public" (production) or "private" (a private staging server: every page
# and API call asks for the login MDARIX_SITE_LOGIN_USER / MDARIX_SITE_LOGIN_HASH, a bcrypt hash made with
# "caddy hash-password"). Only the liveness and status endpoints stay open, for the uptime monitors. Any other value
# names no snippet, and Caddy refuses to start; so does "private" without a user and hash.
(site_access_public) {
}

(site_access_private) {
	@needs_login not path /health/live /health/status
	basic_auth @needs_login {
		{$MDARIX_SITE_LOGIN_USER} {$MDARIX_SITE_LOGIN_HASH}
	}
}

# MDARIX_WWW_REDIRECT=on also answers www.<domain> and sends it to <domain> (its own certificate, so the www DNS record
# must exist). Off by default: a staging host name has no www record, and asking for its certificate would only fail.
(www_redirect_off) {
}

(www_redirect_on) {
	www.{$MDARIX_DOMAIN} {
		redir https://{$MDARIX_DOMAIN}{uri} permanent
	}
}

import www_redirect_{$MDARIX_WWW_REDIRECT:off}

{$MDARIX_DOMAIN} {
	import site_access_{$MDARIX_SITE_ACCESS:public}

	encode zstd gzip

	# Uploads above this are refused here, before they reach the API (imports allow 10 MB, attachments 10 MB).
	request_body {
		max_size 25MB
	}

	# A body the API reads as JSON is parsed whole before any sign-in check or rate limit, so a large one ties up an
	# API worker: above 1 MiB it is refused here (413). The API reads a body as JSON when its Content-Type is
	# application/json or application/*+json (any case, any parameters), or when there is no Content-Type at all.
	# The largest JSON the application sends is a case scope (up to about 650 KB, usually under 150 KB); webhooks are
	# capped at 1 MiB by the API itself. Files go as multipart, text/csv or Excel bytes and keep the limit above.
	@json_body header_regexp Content-Type (?i)^\s*(application/([a-z0-9.+-]*\+)?json\b|$)
	request_body @json_body {
		max_size 1MiB
	}
	@no_content_type header !Content-Type
	request_body @no_content_type {
		max_size 1MiB
	}

	header {
		# HSTS preload: add "; preload" and submit the domain at hstspreload.org only once every subdomain of the
		# registered domain serves HTTPS for good: removal from browsers' preload lists takes months.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
		-Server
	}

	# Readiness details (components, errors) are for the operator, not the internet: they are read on the VM
	# (DEPLOYMENT.md). Uptime monitors and status pages use /health/status, which says only ok, degraded or down.
	@internal_health path /health /health/ready
	handle @internal_health {
		respond 404
	}

	handle /health/live {
		reverse_proxy api:8000
	}

	handle /health/status {
		reverse_proxy api:8000
	}

	# API responses carry personal and customer data: never kept by a browser or an intermediate cache.
	handle /api/* {
		# ">" replaces whatever the API sent, once the response is written.
		header >Cache-Control "no-store"
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto {scheme}
			# The platform's cells present a client certificate (docs/runbooks/CELL_LINK.md: the tls client_auth
			# block of a PLATFORM deployment); its fingerprint reaches the API here and never from a client, since
			# header_up replaces whatever a caller sent. Empty when no certificate was presented.
			header_up X-Client-Certificate-Fingerprint {http.request.tls.client.fingerprint}
		}
	}

	# The free-trial videos for the website's /videos page (MP4, WebVTT captions, posters and videos.json), from the
	# server's videos/ folder mounted read-only (videos/README.md): a video is published by copying its files there.
	handle_path /media/videos/* {
		header Cache-Control "public, max-age=3600"
		root * /media/videos
		file_server
	}

	# Built assets carry a content hash in their names: cache them for a year. Pages are revalidated every time,
	# so a deploy reaches everyone at once.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format filter {
			wrap json
			# The query string never lands in the access log. Activation, invitation and password-reset links carry a
			# single-use token in it (anyone reading logs could use an unexpired link), and searches carry what people
			# looked for in their records. The Referer header goes too (the pages a link opens send it with the
			# token). Caddy already redacts cookies and Authorization headers.
			request>uri regexp "\?.*$" ""
			request>headers>Referer delete
		}
	}
}
