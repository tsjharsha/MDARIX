.env
.env.*
!.env.example
!.env.production.example
!.env.migrate.example
frontend/vite.zz-*.config.ts
.venv/
__pycache__/
*.pyc
node_modules/
dist/
# The website pages' server-side renderer, built and removed again by npm run build (frontend/scripts/prerender.mjs).
frontend/dist-prerender/
build/
.pytest_cache/
.pytest_tmp/
.coverage
.vscode/
.idea/
*.log
source-simulator.db
mdarix-r1-day0-backup.sql
infrastructure/database/backups/*.sql
infrastructure/database/backups/*.dump
# Playwright report bundles are generated locally and are not source evidence.
/artifacts/playwright-report/data/
/artifacts/playwright-report/trace/
# Local synthetic data-plane backup output is generated by validation scripts.
/artifacts/data-plane-backups/
# Generated MVP validation dumps are local evidence, not repository source.
/artifacts/data-plane-backups-mvp/*.dump
# Local object-storage root and Playwright run state are runtime output.
/.mdarix-object-storage/
/frontend/test-results/

# Local embedding model download cache (fastembed)
.model-cache/

# Generated test evidence: screenshots, browser reports, scans and audit archives are produced by CI and kept as CI
# artifacts, not committed. Small evaluation results that STATUS.md cites (artifacts/*.json, *.csv, *.md) stay tracked.
frontend/artifacts/
artifacts/**/*.png
artifacts/playwright-report/
artifacts/zap-*.html
artifacts/compliance/audit-archives/
artifacts/audit-archives/
artifacts/data-plane-backups/
artifacts/automated-release-gate.md
# Recovery-check records and monthly health reports name customer organisations: sent to them, never committed.
artifacts/recovery-check/
artifacts/health/
# Local demo recordings and their injected recorder helpers are generated evidence, not application source.
artifacts/demo/
# B6a G7: each release check's full output (the summary artifacts/release-checks-<version>.json stays tracked).
artifacts/release-checks/
# B6b B12: the dry-run validation pack (development results, not validation evidence; regenerate it).
artifacts/validation-pack-dryrun/

# Keys, certificates, database dumps and encrypted backups never belong in the repository; the filled production
# settings (.env.production, .env.migrate) are covered by .env.* above.
*.pem
*.key
*.p12
*.dump
*.age
.env.migrate
/certs/
# The staging database's administrator password and TLS key (infrastructure/staging/prepare-database.sh).
/staging-secrets/
.logs/

# Free-trial video files are copied to the server, not committed (videos/README.md).
videos/*
!videos/README.md

# Security scan reports (scripts/security_scan.sh): local evidence only, never committed or uploaded.
/security-reports/
