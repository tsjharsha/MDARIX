{
  "name": "mdarix-r1-frontend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc && vite build && vite build --ssr src/site/prerender.tsx --outDir dist-prerender --emptyOutDir && node scripts/prerender.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "tsc --noEmit --noUnusedLocals -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:scenes": "node scripts/check-scenes.mjs",
    "check:phone": "node scripts/check-phone.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.6.1",
    "axe-playwright": "^2.2.2",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "vite": "8.3.7",
    "vitest": "5.0.1"
  }
}
