# syntax=docker/dockerfile:1.7
# MDARIX web front door: Caddy serves the built website and app over HTTPS (automatic certificates) and proxies
# /api to the API container. Base images pinned by digest.
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# The release the bundle is built as (frontend/vite.config.ts reads ../VERSION): the app compares it with the version
# the API reports and offers a reload when a newer one is deployed.
COPY VERSION /VERSION
RUN npm run build

# Rebuild the pinned Caddy release with a patched Go toolchain. The upstream Caddy image can lag a Go security
# release even when the Caddy application itself is current; compiling the same release here prevents the runtime
# image from retaining a fixable standard-library vulnerability. Go's module checksum database verifies downloads.
# Caddy's own main package (cmd/caddy/main.go) is built as a module of its own, so a dependency with a security fix can
# be raised above the version the Caddy release pins: golang.org/x/net v0.62.0 (CVE-2026-78669, CVE-2026-78661; v2.11.7 pins v0.59.0) and\n# github.com/go-jose/go-jose/v4 v4.1.6 (CVE-2026-116587). Go 1.26.10 fixes CVE-2026-111943 (crypto/x509).
# Drop the raise once a Caddy release requires the fixed version itself. The last line prints what was built.
# The module downloads are tried up to five times: the 0.10.67 deploy stopped twice on a dropped HTTP/2 stream from
# proxy.golang.org / sum.golang.org. What one attempt downloaded stays in the module cache; the next fetches the rest.
FROM golang:1.26.10-alpine@sha256:87c65a688975c0b1d4585d204874c45ca78354670e3a5f11368c5a492303d696 AS caddy-build
WORKDIR /src/caddy
RUN printf '%s\n' 'package main' '' 'import (' '	caddycmd "github.com/caddyserver/caddy/v2/cmd"' \
        '	_ "github.com/caddyserver/caddy/v2/modules/standard"' ')' '' 'func main() { caddycmd.Main() }' > main.go \
    && go mod init mdarix.local/caddy \
    && for attempt in 1 2 3 4 5; do \
         go get github.com/caddyserver/caddy/v2@v2.11.7 golang.org/x/net@v0.62.0 github.com/go-jose/go-jose/v4@v4.1.6 && go mod tidy && break; \
         [ "$attempt" = 5 ] && exit 1; echo "module download attempt $attempt failed; trying again"; sleep 15; \
       done \
    && GOMAXPROCS=2 CGO_ENABLED=0 go build -p=2 -trimpath -o /go/bin/caddy . \
    && go version -m /go/bin/caddy | grep -E 'caddyserver/caddy/v2[[:space:]]|golang.org/x/net[[:space:]]|go-jose/go-jose'

FROM caddy:2.11-alpine@sha256:881bbc60f9986d5ab8e7cfd6cf7e4ef3c9c0439fef2429d035d065577882f028
# The pinned base keeps Caddy fixed; its OS packages take Alpine's security fixes at build time (CI scans the result).
RUN apk upgrade --no-cache
# Caddy runs as an unprivileged user, caddy (uid and gid 10002), not root (SEC-10). It needs no capability to listen on
# 80 and 443: docker-compose.prod.yml lets the container's own network namespace bind ports from 80 up
# (net.ipv4.ip_unprivileged_port_start), so the binary carries no file capability, which no-new-privileges would refuse
# anyway. /data and /config belong to caddy, so a new volume starts out as Caddy's; volumes a root Caddy wrote are
# given to it by the web-volumes job (caddy-volumes.sh) before web starts.
RUN addgroup -S -g 10002 caddy \
    && adduser -S -D -H -u 10002 -G caddy -h /data -s /sbin/nologin caddy \
    && chown -R caddy:caddy /data /config
COPY --from=caddy-build /go/bin/caddy /usr/bin/caddy
COPY --chmod=755 infrastructure/docker/caddy-volumes.sh /usr/local/bin/caddy-volumes
COPY infrastructure/docker/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /build/dist /srv
USER caddy
