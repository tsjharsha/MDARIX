# The API image carries the server code only: no secrets, tests, simulators, frontend sources or local files.
.env
.env.*
**/.env
.git
.github
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.pytest_tmp
.ruff_cache
node_modules
frontend
tests
source_simulator/*
# Migration md11 reads the source catalog.
!source_simulator/source_catalog.json
docs
# The validation evidence screen reads the requirement mapping and builds the validation pack (E2).
!docs/validation
artifacts
.mdarix-object-storage
.mdarix-embedding-cache
infrastructure/database/backups
infrastructure/docker
*.db
*.sqlite
*.log
*.dump
Dockerfile*
docker-compose*.yml
Caddyfile*
STATUS.md
requirements-dev.txt
# Keys, certificates and backups (the database CA is mounted at run time, never built in).
**/*.pem
**/*.key
**/*.p12
**/*.age
.env.migrate
certs
.logs
