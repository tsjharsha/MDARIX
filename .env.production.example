# MDARIX production settings (docker-compose.prod.yml). Copy to .env.production on the server, fill every value,
# and keep the file readable by the deploy user only (chmod 600). Never commit the filled file.
# Every long-running service (api, worker, scheduler) reads this file. The database owner's password, dedicated-plane
# owner connection strings and the backup credentials go in .env.migrate instead (template: .env.migrate.example),
# which only the one-shot migrate and backup jobs load: the API refuses to start with them in its environment.
# Compose reads ${...} values in docker-compose.prod.yml from this file only when given --env-file .env.production
# (or COMPOSE_ENV_FILES=.env.production), so every documented command passes it.
# The API refuses to start while a required value is missing or unsafe; list the problems with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production run --rm --no-deps api python -m backend.app.config_check --offline
# Generate random values with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate 32-byte keys with:    python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Full reference: docs/runbooks/ENVIRONMENT_VARIABLES.md

# ---------------------------------------------------------------- Release and address
MDARIX_ENV=production
# Which part of MDARIX this deployment is (docs/runbooks/ENVIRONMENT_VARIABLES.md): MULTI (everything, as today),
# PLATFORM (platform administration only) or CELL (one organization in its own database; then name it below).
MDARIX_DEPLOYMENT_ROLE=MULTI
# full (every screen and route, as built) or mvp (the lightweight MVP: parked areas hidden, their routes 404).
# Pilots run mvp; free trials show the MVP interface whatever this says.
MDARIX_FEATURE_SET=mvp
MDARIX_CELL_TENANT_ID=
MDARIX_CELL_TENANT_KEY=
# A CELL also pins the platform's package-signing public key (scripts/cell_platform.py keygen); scripts/cell_install.py
# writes the whole cell configuration, including this, into the cell's own settings file.
MDARIX_PLATFORM_SIGNING_PUBLIC_KEY=
# A CELL reports to the platform at this https address (docs/runbooks/CELL_LINK.md); its enrollment token and
# identity directory come from scripts/cell_install.py. A PLATFORM names its certificate authority files instead.
MDARIX_PLATFORM_URL=
MDARIX_PLATFORM_CA_KEY_FILE=
MDARIX_PLATFORM_CA_CERT_FILE=
# The release tag to run (git tag and image tag, e.g. v0.9.0), and where its images live. Leave
# MDARIX_IMAGE_REPOSITORY at "mdarix" only when building on the server instead of pulling released images.
MDARIX_RELEASE=v0.9.0
MDARIX_IMAGE_REPOSITORY=ghcr.io/stelikicherla-stack/mdarix-r1
# The domain people type, and the https address of the app (same host).
MDARIX_DOMAIN=app.example.com
MDARIX_APP_URL=https://app.example.com
# Additional browser origins are normally empty; every value must use https in production.
MDARIX_ALLOWED_ORIGINS=
# Let's Encrypt account email for the TLS certificate.
ACME_EMAIL=ops@example.com
# on: www.<MDARIX_DOMAIN> also answers and redirects to MDARIX_DOMAIN (needs a www DNS record). off for a staging host.
MDARIX_WWW_REDIRECT=off
# Other host names that answer here and redirect permanently to MDARIX_DOMAIN, path and query kept (separated by
# spaces, in double quotes), e.g. a former main domain and other registered domains: "mdarix.in www.mdarix.in". Caddy
# obtains a certificate for each, so list only names whose DNS points at this server. Empty: no other names answer.
MDARIX_REDIRECT_DOMAINS=
# Who may open the site: public, or private (a private staging server: every page asks for this login first). The
# hash comes from: docker run --rm caddy:2.11-alpine caddy hash-password. Keep it in single quotes: it contains "$".
MDARIX_SITE_ACCESS=public
MDARIX_SITE_LOGIN_USER=
MDARIX_SITE_LOGIN_HASH=

# ---------------------------------------------------------------- Database (managed Postgres 16 with pgvector)
POSTGRES_HOST=your-db-host.example.net
POSTGRES_PORT=5432
POSTGRES_DB=mdarix
POSTGRES_SSLMODE=verify-full
# CA bundle of the managed database when its certificate is not signed by a public CA (RDS, Cloud SQL): put the file
# in the host folder MDARIX_DB_CA_DIR (default ./certs, mounted read-only at /etc/mdarix/certs in every container that
# talks to the database) and name it here. Empty = the system's public CAs.
MDARIX_DB_CA_DIR=./certs
POSTGRES_SSLROOTCERT=
# e.g. POSTGRES_SSLROOTCERT=/etc/mdarix/certs/db-ca.pem
# Long-running services connect as the least-privilege role (row-level security applies to everything they do).
POSTGRES_USER=mdarix_runtime
POSTGRES_PASSWORD=
MDARIX_DB_RUNTIME_USER=mdarix_runtime
MDARIX_DB_RUNTIME_PASSWORD=
# The schema owner's name (not its password, which is in .env.migrate): the API refuses to run as this account.
MDARIX_DB_OWNER_USER=
MDARIX_DB_POOL_SIZE=5
MDARIX_DB_MAX_OVERFLOW=10
# Secret that lets the server (never a SQL statement alone) read across tenants for platform work.
MDARIX_RLS_SYSTEM_TOKEN=

# ---------------------------------------------------------------- Keys (URL-safe base64 of 32 random bytes)
MDARIX_MFA_ENCRYPTION_KEY=
MDARIX_CONNECTOR_ENCRYPTION_KEY=
MDARIX_OBJECT_STORAGE_ENCRYPTION_KEY=
# Key rotation (docs/runbooks/KEY_ROTATION.md, "Rotate with a keyring"). Leave these empty until the first rotation:
# empty, the MFA and file keys work exactly as before. <name>_ID names the current key (k2, k3...); <name>S lists the
# older keys still readable, "k1:<base64>,k0:<base64>" (the key in use before the first rotation is k1).
MDARIX_MFA_ENCRYPTION_KEY_ID=
MDARIX_MFA_ENCRYPTION_KEYS=
MDARIX_OBJECT_STORAGE_ENCRYPTION_KEY_ID=
MDARIX_OBJECT_STORAGE_ENCRYPTION_KEYS=
# Random strings of 48+ characters.
MDARIX_OBJECT_STORAGE_SIGNING_SECRET=
MDARIX_DEMO_REQUEST_SALT=
MDARIX_RATE_LIMIT_SALT=

# ---------------------------------------------------------------- Files
# s3 (pilots): an S3-compatible bucket with versioning; the provider keeps the files (BACKUP_AND_RESTORE.md).
# local: encrypted files on the "objects" volume, copied off-site only by the daily backup (up to 24 h of files at risk).
MDARIX_OBJECT_STORAGE_PROVIDER=s3
MDARIX_OBJECT_STORAGE_BUCKET=
MDARIX_OBJECT_STORAGE_REGION=
MDARIX_OBJECT_STORAGE_ENDPOINT=
MDARIX_OBJECT_STORAGE_ACCESS_KEY=
MDARIX_OBJECT_STORAGE_SECRET_KEY=

# Virus scanning of uploads (the clamav service in docker-compose.prod.yml).
MDARIX_CLAMD_HOST=clamav

# ---------------------------------------------------------------- Email (any SMTP provider: SES, Postmark, SendGrid, M365)
MDARIX_SMTP_HOST=
MDARIX_SMTP_PORT=587
MDARIX_SMTP_USERNAME=
MDARIX_SMTP_PASSWORD=
MDARIX_SMTP_FROM=MDARIX <no-reply@example.com>
MDARIX_SMTP_VERIFIED_DOMAIN=example.com
# Who hears about new trial and demo requests. MDARIX_TRIAL_ALERT_EMAIL is required (trial requests waiting for review,
# trials asking to end early); the demo address is optional and falls back to it.
MDARIX_TRIAL_ALERT_EMAIL=
MDARIX_DEMO_ALERT_EMAIL=

# ---------------------------------------------------------------- Company and legal (shown on the website and in emails)
MDARIX_COMPANY_LEGAL_NAME=
MDARIX_COMPANY_ADDRESS=
MDARIX_SUPPORT_EMAIL=
MDARIX_PRIVACY_EMAIL=
# Set to true only after a lawyer approved the privacy policy, terms and trial agreement.
MDARIX_LEGAL_TEXT_APPROVED=false
# Staging only (ADR-017): true lets a private staging server (MDARIX_SITE_ACCESS=private) run with the draft legal
# texts and without the company details. Refused in production.
MDARIX_PRIVATE_STAGING_ACKNOWLEDGED=false
# The approved documents (privacy.md, terms.md, trial-agreement.md) live in ./legal on the server; see legal/README.md.
# docker-compose.prod.yml mounts that folder read-only at this path.
MDARIX_LEGAL_DIR=/var/lib/mdarix/legal

# ---------------------------------------------------------------- AI
# controlled = no model (rule-based answers). Otherwise a provider you hold a no-training / DPA contract with, named
# in MDARIX_GENAI_CONTRACTED_PROVIDERS, or ollama on your own server. Free tiers are refused in production.
# Example under a commercial agreement: MDARIX_GENAI_PROVIDER=anthropic and MDARIX_GENAI_CONTRACTED_PROVIDERS=anthropic.
MDARIX_GENAI_PROVIDER=controlled
MDARIX_GENAI_API_KEY=
MDARIX_GENAI_MODEL=
MDARIX_GENAI_CONTRACTED_PROVIDERS=
# Evidence search embeds text with the model shipped in the image; a server never downloads it, and the start-up
# check refuses a missing or altered model. Leave "local" ("deterministic" is for automated tests only).
MDARIX_EMBEDDING_PROVIDER=local
# Retention of each contracted provider (docs/compliance/AI_PROVIDER_REGISTER.md): set MDARIX_GENAI_<NAME>_ZDR=true
# (for example MDARIX_GENAI_ANTHROPIC_ZDR=true) once zero data retention is confirmed, or accept the provider's
# limited retention under your DPA with MDARIX_GENAI_ACCEPT_RETENTION=true. Without either, the provider is refused.
MDARIX_GENAI_ACCEPT_RETENTION=
MDARIX_GENAI_FALLBACKS=
# Monthly token allowance for an organization without its own (platform administrators set per-organization ones).
MDARIX_GENAI_TENANT_MONTHLY_TOKENS=2000000
# Cost shown to administrators for provider usage reconciliation.
MDARIX_GENAI_COST_PER_1K_TOKENS=

# ---------------------------------------------------------------- Operations
# Slack/Teams incoming webhook and/or an email address for operational alerts (dead letters, stopped worker,
# failing scheduled jobs).
MDARIX_ALERT_WEBHOOK=
MDARIX_ALERT_EMAIL=
# Dead-man's switch (Healthchecks.io, Better Stack heartbeat...): pinged every five minutes while the scheduler
# runs, so an outside monitor notices when it stops. Required in production (https://).
MDARIX_SCHEDULER_HEARTBEAT_URL=
# Error reporting (optional).
MDARIX_SENTRY_DSN=
MDARIX_LOG_LEVEL=INFO
MDARIX_SESSION_IDLE_MINUTES=30
# One trusted proxy hop when Caddy is directly in front of the API.
MDARIX_TRUSTED_PROXY_HOPS=1
# Keep the default administrator MFA policy explicit in the deployment manifest.
MDARIX_REQUIRE_MFA_ROLES=PLATFORM_ADMIN,CUSTOMER_ADMIN,LEADER,APPROVER
MDARIX_REQUIRE_MFA_FOR_SIGNATURES=true
# Private connector hosts are forbidden by default. If deliberately configured, the
# acknowledgement must also be true so the SSRF exception cannot be enabled accidentally.
MDARIX_CONNECTOR_ALLOWED_HOSTS=
MDARIX_CONNECTOR_ALLOWED_HOSTS_ACKNOWLEDGED=false

# ---------------------------------------------------------------- Backups (the backup job; docs/runbooks/BACKUP_AND_RESTORE.md)
# The backup job reads this file and .env.migrate; its database login and the bucket credentials (AWS_*) are in
# .env.migrate.
# Host folder for local copies; create it once with: sudo install -d -o 70 -g 70 -m 700 /var/backups/mdarix
MDARIX_BACKUP_DIR=/var/backups/mdarix
# age public key (age1...) every backup is encrypted to; the private key is kept offline, never on this server.
MDARIX_BACKUP_AGE_RECIPIENT=
# Off-site copy (bucket with versioning and object lock in another account or region), e.g. s3://mdarix-backups/prod
# Required in production, unless copies leave the server another way (e.g. the managed database's own backups and
# point-in-time recovery): then set MDARIX_BACKUP_OFFSITE_ACKNOWLEDGED=true instead.
MDARIX_BACKUP_S3_URI=
MDARIX_BACKUP_OFFSITE_ACKNOWLEDGED=false
# Days of local copies kept on the VM (the bucket's lifecycle rule keeps the off-site ones).
MDARIX_BACKUP_KEEP_DAYS=14
# Dead-man's switch pinged after every successful backup (alerts when backups stop arriving). Required in
# production (https://).
MDARIX_BACKUP_HEARTBEAT_URL=

# ---------------------------------------------------------------- Dedicated tenant databases (optional; pilots use the shared one)
# One line per dedicated plane registered in tenant_data_planes, e.g.:
# MDARIX_DATA_PLANE_ACME_DATABASE_URL=postgresql+pg8000://mdarix_runtime:...@host:5432/mdarix_acme
# The plane owner's connection string (MDARIX_DATA_PLANE_<KEY>_DATABASE_URL_OWNER) goes in .env.migrate.
