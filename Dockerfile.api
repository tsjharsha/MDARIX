# syntax=docker/dockerfile:1.7
# MDARIX API, background worker and scheduler: one image, three commands (see docker-compose.prod.yml).
# Base image pinned by digest; dependencies installed from the hashed lock (requirements.txt).
FROM python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MDARIX_ENV=production \
    PYTHONPATH=/app \
    MDARIX_EMBEDDING_CACHE_DIR=/opt/mdarix/embeddings \
    HF_HUB_OFFLINE=0

# The pinned base keeps Python fixed; its Debian packages take the security fixes published since the base was built
# (CI scans the result with Trivy and fails on a fixable HIGH or CRITICAL finding).
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 mdarix \
    && useradd --system --uid 10001 --gid mdarix --home-dir /app --shell /usr/sbin/nologin mdarix

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --require-hashes -r /app/requirements.txt

# The embedding model is part of the image, so a production server never downloads it at runtime. It is pinned to one
# commit of the ONNX repository fastembed loads for BAAI/bge-small-en-v1.5, so a rebuild cannot silently change the
# vectors evidence search compares. To update: read the new commit with
#   curl -s https://huggingface.co/api/models/Qdrant/bge-small-en-v1.5-onnx-Q | python -c "import json,sys; print(json.load(sys.stdin)['sha'])"
# set EMBEDDING_REVISION to it, and re-index evidence (scripts/index_evidence.py) if the model weights changed.
ARG EMBEDDING_REPO=Qdrant/bge-small-en-v1.5-onnx-Q
ARG EMBEDDING_REVISION=aa8f8b060edb00e03bfdd08813a2949946c8ba55
RUN <<PY python
import os
from pathlib import Path

from huggingface_hub import snapshot_download

cache = os.environ["MDARIX_EMBEDDING_CACHE_DIR"]
repo, revision = os.environ["EMBEDDING_REPO"], os.environ["EMBEDDING_REVISION"]
snapshot_download(repo_id=repo, revision=revision, cache_dir=cache, allow_patterns=["*.json", "*.onnx", "*.txt"])
# fastembed loads the cache offline through the "main" ref; point it at the pinned commit.
refs = Path(cache) / f"models--{repo.replace('/', '--')}" / "refs"
refs.mkdir(parents=True, exist_ok=True)
(refs / "main").write_text(revision)

from fastembed import TextEmbedding

vector = next(iter(TextEmbedding("BAAI/bge-small-en-v1.5", cache_dir=cache, local_files_only=True).embed(["pinned"])))
assert len(vector) == 384, len(vector)
PY
RUN chmod -R a+rX /opt/mdarix
ENV HF_HUB_OFFLINE=1

COPY --chown=root:root . /app
RUN python -m compileall -q /app/backend /app/auth /app/genai \
    && mkdir -p /var/lib/mdarix/objects /var/lib/mdarix/reports \
    && chown -R mdarix:mdarix /var/lib/mdarix

USER mdarix
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3)"

# Behind Caddy: the client address comes from X-Forwarded-For via MDARIX_TRUSTED_PROXY_HOPS=1, so uvicorn's own
# proxy-header rewriting stays off. Access logs come from the API's request log line instead.
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-proxy-headers", "--no-access-log", "--timeout-graceful-shutdown", "20"]
