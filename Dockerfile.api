# syntax=docker/dockerfile:1.7
# MDARIX API, background worker and scheduler: one image, three commands (see docker-compose.prod.yml).
# Base image pinned by digest; dependencies installed from the hashed lock (requirements.txt).
FROM python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MDARIX_ENV=production \
    MDARIX_EMBEDDING_CACHE_DIR=/opt/mdarix/embeddings \
    HF_HUB_OFFLINE=0

RUN groupadd --system --gid 10001 mdarix \
    && useradd --system --uid 10001 --gid mdarix --home-dir /app --shell /usr/sbin/nologin mdarix

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --require-hashes -r /app/requirements.txt

# The embedding model is part of the image, so a production server never downloads it at runtime.
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5', cache_dir='/opt/mdarix/embeddings')" \
    && chmod -R a+rX /opt/mdarix
ENV HF_HUB_OFFLINE=1

COPY --chown=root:root . /app
RUN python -m compileall -q /app/backend /app/auth /app/genai \
    && mkdir -p /var/lib/mdarix/objects /var/lib/mdarix/reports \
    && chown -R mdarix:mdarix /var/lib/mdarix

USER mdarix
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3)"

# Behind Caddy: the client address comes from X-Forwarded-For via MDARIX_TRUSTED_PROXY_HOPS=1, so uvicorn's own
# proxy-header rewriting stays off. Access logs come from the API's request log line instead.
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-proxy-headers", "--no-access-log", "--timeout-graceful-shutdown", "20"]
